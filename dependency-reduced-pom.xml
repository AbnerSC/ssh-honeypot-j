<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.open.scdm</groupId>
  <artifactId>ssh-honeypot-j</artifactId>
  <version>1.0.2</version>
  <description>Java版本 SSH 蜜罐</description>
  <build>
    <finalName>ssh-honeypot-j</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.3</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>org.open.scdm.honeypot.Main</mainClass>
                  <manifestEntries>
                    <Add-Opens>java.base/java.lang</Add-Opens>
                    <JVM-Options>-XX:+UseCompactObjectHeaders -XX:-EnableFinalization</JVM-Options>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>io.fabric8</groupId>
        <artifactId>docker-maven-plugin</artifactId>
        <version>0.46.0</version>
        <executions>
          <execution>
            <id>docker-build-push</id>
            <phase>deploy</phase>
            <goals>
              <goal>build</goal>
              <goal>push</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <images>
            <image>
              <name>${docker.image}</name>
              <build>
                <from>${docker.baseImage}</from>
                <workdir>/app</workdir>
                <assembly>
                  <targetDir>/app</targetDir>
                  <inline>
                    <files>
                      <file>
                        <source>${project.build.directory}/${project.build.finalName}.jar</source>
                        <destName>app.jar</destName>
                        <fileMode>0644</fileMode>
                      </file>
                      <file>
                        <source>${project.basedir}/config.yaml</source>
                        <destName>config.yaml</destName>
                        <fileMode>0644</fileMode>
                      </file>
                    </files>
                  </inline>
                </assembly>
                <entryPoint>
                  <exec>
                    <arg>java</arg>
                    <arg>-XX:+UseCompactObjectHeaders</arg>
                    <arg>-XX:-EnableFinalization</arg>
                    <arg>-jar</arg>
                    <arg>app.jar</arg>
                  </exec>
                </entryPoint>
                <ports>
                  <port>2222</port>
                  <port>2323</port>
                </ports>
                <volumes>
                  <volume>/app/logs</volume>
                </volumes>
              </build>
            </image>
          </images>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <docker.baseImage>openjdk:25-ea-oracle</docker.baseImage>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <docker.image>${docker.registry}/${project.artifactId}:${project.version}</docker.image>
    <docker.registry>repo.pi.mmxx.fun/docker-releases-amd64</docker.registry>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>
</project>
