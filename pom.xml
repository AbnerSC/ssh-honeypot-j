<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.open.scdm</groupId>
    <artifactId>ssh-honeypot-j</artifactId>
    <version>1.0.3</version>
    <packaging>jar</packaging>
    <description>Java版本 SSH 蜜罐</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- ============ Docker 镜像配置 ============ -->
        <!-- 基础镜像（若本地无该镜像且需从 Nexus 拉取，可用 -Ddocker.baseImage=repo.pi.mmxx.fun/docker-releases-amd64/openjdk:25-ea-oracle 覆盖） -->
        <docker.baseImage>openjdk:25-ea-oracle</docker.baseImage>
        <!-- Nexus Docker 仓库（host/repository 形式） -->
        <docker.registry>repo.pi.mmxx.fun/docker-releases-amd64/scdm</docker.registry>
        <docker.image>${docker.registry}/${project.artifactId}:${project.version}</docker.image>
        <!-- 仓库认证凭据配置在 ~/.m2/settings.xml 的 <servers> 中，id 为 ${docker.registry} 的主机名部分 -->
        <!-- mvn deploy 仅构建并推送 Docker 镜像，不发布 jar 到 Maven 仓库 -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.sshd</groupId>
            <artifactId>sshd-core</artifactId>
            <version>2.19.0</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.18</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>2.0.18</version>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.6</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>ssh-honeypot-j</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.open.scdm.honeypot.Main</mainClass>
                                    <manifestEntries>
                                        <!-- JDK 25 运行时优化：紧凑对象头(JEP 519)、禁用遗留 finalization(JEP 513) -->
                                        <Add-Opens>java.base/java.lang</Add-Opens>
                                        <JVM-Options>-XX:+UseCompactObjectHeaders -XX:-EnableFinalization</JVM-Options>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Docker 镜像构建/推送插件：
                 mvn package  -> 仅打包 jar，不构建镜像（避免本地无 Docker 时失败）
                 mvn deploy   -> 构建本地 Docker 镜像并推送到 Nexus 仓库 -->
            <plugin>
                <groupId>io.fabric8</groupId>
                <artifactId>docker-maven-plugin</artifactId>
                <version>0.49.0</version>
                <configuration>
                    <images>
                        <image>
                            <name>${docker.image}</name>
                            <build>
                                <from>${docker.baseImage}</from>
                                <!-- 附加标签：除版本号标签外，额外推送 latest 标签 -->
                                <tags>
                                    <tag>latest</tag>
                                </tags>
                                <workdir>/app</workdir>
                                <assembly>
                                    <targetDir>/app</targetDir>
                                    <inline>
                                        <files>
                                            <file>
                                                <source>${project.build.directory}/${project.build.finalName}.jar</source>
                                                <destName>app.jar</destName>
                                                <fileMode>0644</fileMode>
                                            </file>
                                            <file>
                                                <source>${project.basedir}/config.yaml</source>
                                                <destName>config.yaml</destName>
                                                <fileMode>0644</fileMode>
                                            </file>
                                        </files>
                                    </inline>
                                </assembly>
                                <!-- JVM 参数与 MANIFEST 中 JVM-Options 保持一致 -->
                                <entryPoint>
                                    <exec>
                                        <arg>java</arg>
                                        <arg>-XX:+UseCompactObjectHeaders</arg>
                                        <arg>-jar</arg>
                                        <arg>app.jar</arg>
                                    </exec>
                                </entryPoint>
                                <ports>
                                    <port>2222</port>
                                    <port>2323</port>
                                </ports>
                                <volumes>
                                    <volume>/app/logs</volume>
                                </volumes>
                            </build>
                        </image>
                    </images>
                    <!-- 仓库认证：从 ~/.m2/settings.xml 的 <servers> 中读取（id = ${docker.registry} 的主机名） -->
                </configuration>
                <executions>
                    <!-- mvn deploy 时构建镜像并推送到 Nexus 仓库 -->
                    <execution>
                        <id>docker-build-push</id>
                        <phase>deploy</phase>
                        <goals>
                            <goal>build</goal>
                            <goal>push</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
