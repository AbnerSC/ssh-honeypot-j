<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.open.scdm</groupId>
    <artifactId>ssh-honeypot-j</artifactId>
    <version>1.0.1</version>
    <packaging>jar</packaging>
    <description>Java版本 SSH 蜜罐</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Apache MINA SSHD: SSH 服务端 -->
        <dependency>
            <groupId>org.apache.sshd</groupId>
            <artifactId>sshd-core</artifactId>
            <version>2.19.0</version>
        </dependency>
        <!-- 显式锁定 slf4j-api 2.x，避免 sshd-core 传递的 1.7.x 导致 StaticLoggerBinder 警告 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.18</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>2.0.18</version>
        </dependency>
        <!-- SnakeYAML: YAML 配置文件解析 -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.6</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>ssh-honeypot-j</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.open.scdm.honeypot.Main</mainClass>
                                    <manifestEntries>
                                        <!-- JDK 25 运行时优化：紧凑对象头(JEP 519)、禁用遗留 finalization(JEP 513) -->
                                        <Add-Opens>java.base/java.lang</Add-Opens>
                                        <JVM-Options>-XX:+UseCompactObjectHeaders -XX:-EnableFinalization</JVM-Options>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
