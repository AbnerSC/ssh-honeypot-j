<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.open.scdm</groupId>
    <artifactId>ssh-honeypot-j</artifactId>
    <version>1.1.3</version>
    <packaging>jar</packaging>
    <description>Java版本 SSH 蜜罐</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- ============ Docker 镜像配置 ============ -->
        <!-- 基础镜像 -->
        <docker.baseImage>eclipse-temurin:25-jdk-noble</docker.baseImage>
        <!-- Nexus Docker 仓库（host/repository 形式） -->
        <docker.registry>repo.pi.mmxx.fun/docker-releases-amd64/scdm</docker.registry>
        <docker.image>${docker.registry}/${project.artifactId}:${project.version}</docker.image>
        <!-- 仓库认证凭据配置在 ~/.m2/settings.xml 的 <servers> 中，id 为各 registry 的主机名部分 -->
        <!-- mvn deploy 仅构建并推送 Docker 镜像，不发布 jar 到 Maven 仓库 -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.sshd</groupId>
            <artifactId>sshd-core</artifactId>
            <version>2.19.0</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.18</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>2.0.18</version>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.6</version>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.53.2.1</version>
        </dependency>
        <!-- ip2region：离线 IP 归属地库（xdb 外部库文件），解析攻击来源/访问 IP 为“国家 省份 城市” -->
        <dependency>
            <groupId>org.lionsoul</groupId>
            <artifactId>ip2region</artifactId>
            <version>3.3.7</version>
        </dependency>
        <!-- ============ Web 可视化控制台 ============ -->
        <!-- Javalin：轻量嵌入式 Web 框架（Jetty 12 / jakarta.servlet），承载管理 API 与静态前端 -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>7.2.3</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.14.0</version>
        </dependency>
        <!-- ECharts WebJar：前端图表库随 fat-jar 打包，离线环境可用 -->
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>echarts</artifactId>
            <version>6.1.0</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>ssh-honeypot-j</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <!-- Jetty 等依赖包含 META-INF/services 服务声明，shade 合并避免覆盖丢失 -->
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.open.scdm.honeypot.Main</mainClass>
                                    <manifestEntries>
                                        <!-- JDK 25 运行时优化：紧凑对象头(JEP 519)、禁用遗留 finalization(JEP 513)；
                                             sqlite-jdbc 需加载 native 库，显式授权避免后续 JDK 拦截 -->
                                        <Add-Opens>java.base/java.lang</Add-Opens>
                                        <JVM-Options>--enable-native-access=ALL-UNNAMED -XX:+UseCompactObjectHeaders -XX:-EnableFinalization -XX:MaxRAMPercentage=75.0</JVM-Options>
                                        <!-- Jetty 等依赖为 Multi-Release jar，合并后保留标记 -->
                                        <Multi-Release>true</Multi-Release>
                                        <!-- 注入 pom.xml 项目版本号，运行时读取用于启动横幅展示 -->
                                        <App-Version>${project.version}</App-Version>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Docker 镜像构建/推送插件：
                 mvn package  -> 仅打包 jar，不构建镜像（避免本地无 Docker 时失败）
                 mvn deploy   -> 构建本地 Docker 镜像并推送到 Nexus 与阿里云容器镜像仓库 -->
            <plugin>
                <groupId>io.fabric8</groupId>
                <artifactId>docker-maven-plugin</artifactId>
                <version>0.49.0</version>
                <configuration>
                    <images>
                        <image>
                            <name>${docker.image}</name>
                            <build>
                                <from>${docker.baseImage}</from>
                                <!-- 附加标签：除版本号标签外，额外推送 latest 标签 -->
                                <tags>
                                    <tag>latest</tag>
                                </tags>
                                <workdir>/app</workdir>
                                <assembly>
                                    <targetDir>/app</targetDir>
                                    <inline>
                                        <files>
                                            <file>
                                                <source>${project.build.directory}/${project.build.finalName}.jar</source>
                                                <destName>app.jar</destName>
                                                <fileMode>0644</fileMode>
                                            </file>
                                            <file>
                                                <source>${project.basedir}/config.yaml</source>
                                                <destName>config.yaml</destName>
                                                <fileMode>0644</fileMode>
                                            </file>
                                        </files>
                                    </inline>
                                </assembly>
                                <!-- JVM 参数与 MANIFEST 中 JVM-Options 保持一致；
                                     MaxRAMPercentage：低配额容器下默认堆仅容器内存 1/4，显式放宽避免 OOM -->
                                <entryPoint>
                                    <exec>
                                        <arg>java</arg>
                                        <arg>--enable-native-access=ALL-UNNAMED</arg>
                                        <arg>-XX:+UseCompactObjectHeaders</arg>
                                        <arg>-XX:MaxRAMPercentage=75.0</arg>
                                        <arg>-jar</arg>
                                        <arg>app.jar</arg>
                                    </exec>
                                </entryPoint>
                                <ports>
                                    <port>2222</port>
                                    <port>2323</port>
                                    <port>3306</port>
                                    <port>5432</port>
                                    <port>6379</port>
                                    <port>8080</port>
                                </ports>
                                <volumes>
                                    <volume>/app/logs</volume>
                                    <volume>/app/db</volume>
                                </volumes>
                            </build>
                        </image>
                    </images>
                    <!-- 仓库认证：从 ~/.m2/settings.xml 的 <servers> 中读取（id = 各 registry 的主机名） -->
                </configuration>
                <executions>
                    <!-- mvn deploy 时构建镜像并推送到 Nexus 与阿里云容器镜像仓库 -->
                    <execution>
                        <id>docker-build-push</id>
                        <phase>deploy</phase>
                        <goals>
                            <goal>build</goal>
                            <goal>push</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
